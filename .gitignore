.DS_Store
node_modules
/dist
/sandbox


# npm workspaces: the only lockfile is the one at the repo root.
# A per-workspace web/package-lock.json is never installed from (Docker and CI
# both run `npm ci` at the root), but Dependabot still scans it, so a stale copy
# reports vulnerabilities that the real dependency tree does not have.
web/package-lock.json

# local env files
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea
.vscode/*
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.py[cod]

# Docker
docker/.env
docker/certs/
!docker/certs/.gitkeep
docker/volumes/
docker/xrootd-data/

# Backend logs
log/
*.log

# Bin directory
/bin

# Ignore test data directories
/amanafov
/testuser1
/testuser2


# Ignore local settings for Claude
.claude/settings.local.json
